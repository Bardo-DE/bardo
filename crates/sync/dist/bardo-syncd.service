# syncd as a systemd user unit: the sync engine (org.bardo.Sync1 on the session bus). It is found,
# and started, by D-Bus activation (dbus/org.bardo.Sync1.service) the first time an app asks for
# a dataset.
#
# syncd signs in for itself ("Continue as": the person picks one of the accounts accountd lists)
# and keeps its own tokens: its registry under $XDG_STATE_HOME/bardo/sync and its secrets in the
# keyring under the namespace bardo.syncd. It talks to the servers itself, so it may use the
# network, and the sign-in's loopback listener needs the inet families. It reads /proc to know who
# is calling, so the unit must not hide other processes' cgroups (no ProtectProc, no PrivatePID).
[Unit]
Description=Bardo sync engine (org.bardo.Sync1)

[Service]
# Fixed role (the caller-identity library's LOADER_VARIABLES, checked by its `Full` proof): the manager's environment must not reach this unit.
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GCONV_PATH GIO_EXTRA_MODULES GTK_MODULES GTK_PATH GST_PLUGIN_PATH GST_PLUGIN_SYSTEM_PATH LIBGL_DRIVERS_PATH MESA_LOADER_DRIVER_OVERRIDE __EGL_VENDOR_LIBRARY_DIRS __EGL_VENDOR_LIBRARY_FILENAMES GBM_BACKENDS_PATH LIBVA_DRIVERS_PATH VK_ICD_FILENAMES VK_DRIVER_FILES VK_ADD_DRIVER_FILES VK_LAYER_PATH VK_ADD_LAYER_PATH VK_INSTANCE_LAYERS VK_LOADER_LAYERS_ENABLE
Type=dbus
BusName=org.bardo.Sync1
ExecStart=/usr/libexec/bardo/bardo-syncd
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=20

# --- Sandbox ---
# The keys that need a mount namespace are in the drop-in sandbox.conf (see its header).
# Unix sockets for the bus; the internet for the servers it syncs with and the sign-in's loopback.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# What syncd keeps: the journals and its own accounts (bardo/sync under $XDG_STATE_HOME), which
# systemd creates, and what it keeps under the data home: the PIM mirrors (bardo/sync/vdir), the
# app folder mirrors (bardo/sync/storage) and the photo libraries (bardo/sync/photos); the drives'
# downloaded files (bardo/sync under $XDG_CACHE_HOME); and its settings, bardo/sync/syncd.toml
# under $XDG_CONFIG_HOME, in a folder of their own since the file is replaced by a rename there
# (bardo/accounts/ itself, with accountd's caller table, stays read-only).
# systemd has no data-directory setting, so the pre-start step, outside the sandbox, makes them;
# sandbox.conf makes the bardo/sync directories writable. A drive's folder in ~/Cloud is not among
# them: bardo-drive-mount makes and mounts it, and syncd only serves the connection it hands back.
StateDirectory=bardo/sync
ExecStartPre=+/usr/bin/mkdir -p %h/.local/share/bardo/sync/vdir %h/.local/share/bardo/sync/storage %h/.local/share/bardo/sync/photos %h/.cache/bardo/sync %h/.config/bardo/sync
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Files syncd creates are private to it.
UMask=0077

[Install]
WantedBy=default.target
