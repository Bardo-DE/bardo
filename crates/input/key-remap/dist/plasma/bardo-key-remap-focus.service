# bardo-key-remap-focus: the Plasma add-on that tells bardo-key-remap which window has focus.
# Install to ~/.config/systemd/user/ (install.sh --plasma-focus does it).
[Unit]
Description=bardo-key-remap focus feed for Plasma (terminal vs default profile)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/bardo-key-remap-focus
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
