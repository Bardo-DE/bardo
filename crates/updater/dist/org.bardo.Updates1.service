# Asks for the update service when something calls org.bardo.Updates1 on the session bus (the
# Software Update page, `bardo-updater status`). Under systemd the bus starts the user unit named below, so
# the service runs exactly as it does at login (same environment, same restarts); Exec is only the
# fallback for a bus that does not talk to systemd, and runs what the unit runs.
[D-BUS Service]
Name=org.bardo.Updates1
Exec=/opt/bardo/current/bin/bardo-updater run
SystemdService=bardo-updater.service
